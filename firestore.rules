rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return 'email' in request.auth.token && request.auth.token.email != null &&
        (request.auth.token.email == "kurdb234@gmail.com" || request.auth.token.email == "nabaz@hookah.com");
    }

    // Only accounts the admin registered in /users get a role.
    // A signed-in account without a /users document (self-registered, or removed by the admin) gets NO access.
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'none';
    }

    function isAdmin() {
      return isAuthenticated() && (isOwnerEmail() || getUserRole() == 'admin');
    }

    function isManager() {
      return isAuthenticated() && getUserRole() == 'manager';
    }

    function isCashier() {
      return isAuthenticated() && getUserRole() == 'cashier';
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    function hasAnyRole() {
      return isAdmin() || isManager() || isCashier();
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if hasAnyRole();
      // Cashiers may only add quick "external" items from the POS ...
      allow create: if isAdminOrManager() || (isCashier() && request.resource.data.section == 'external');
      // ... and only change stock (sales, returns, exchanges, mixing). Prices/costs are admin/manager only.
      allow update: if isAdminOrManager() || (isCashier() && onlyChanges(['stock']));
      allow delete: if isAdminOrManager();
    }

    match /sales/{saleId} {
      allow read: if hasAnyRole();
      allow create, update: if hasAnyRole();
      allow delete: if isAdminOrManager();
    }

    match /returns/{returnId} {
      allow read: if hasAnyRole();
      allow create: if hasAnyRole();
      // debtReduction is written by the cashier right after creating a return on a debt sale
      allow update: if isAdminOrManager() || (hasAnyRole() && onlyChanges(['debtReduction']));
      allow delete: if isAdminOrManager();
    }

    match /exchanges/{exchangeId} {
      allow read: if hasAnyRole();
      allow create: if hasAnyRole();
      allow update, delete: if isAdminOrManager();
    }

    match /debts/{debtId} {
      allow read: if hasAnyRole();
      allow create, update: if hasAnyRole();
      allow delete: if isAdminOrManager();
    }

    match /inventoryHistory/{historyId} {
      allow read: if hasAnyRole();
      allow create: if hasAnyRole();
      allow update, delete: if isAdminOrManager();
    }

    match /settings/{settingId} {
      allow read: if hasAnyRole();
      allow write: if isAdminOrManager();
      // The POS lets a cashier update the USD exchange rate, nothing else (not the Telegram target or PIN)
      allow update: if isCashier() && settingId == 'general' && onlyChanges(['usdExchangeRate']);
    }

    match /companies/{companyId} {
      allow read: if hasAnyRole();
      allow write: if isAdminOrManager();
    }

    match /mix_recipes/{recipeId} {
      allow read: if hasAnyRole();
      allow write: if hasAnyRole();
    }

    match /mix_history/{historyId} {
      allow read: if hasAnyRole();
      allow write: if hasAnyRole();
    }

    match /expenses/{expenseId} {
      allow read: if hasAnyRole();
      allow create: if hasAnyRole();
      allow update, delete: if isAdminOrManager();
    }

    match /shifts/{shiftId} {
      allow read: if hasAnyRole();
      allow create, update: if hasAnyRole();
      allow delete: if isAdminOrManager();
    }
  }
}
